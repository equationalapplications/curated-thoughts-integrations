{
  "name": "@equational-applications/openclaw-curated-thoughts",
  "version": "0.1.0",
  "description": "Curated Thoughts memory integration for OpenClaw",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "lib/src/index.js",
  "exports": {
    ".": "./lib/src/index.js",
    "./doctor": "./lib/scripts/ct_doctor.js"
  },
  "files": [
    "lib",
    "skills",
    "openclaw.plugin.json",
    "scripts/install.sh"
  ],
  "dependencies": {
    "@equational-applications/ct-wisdom-core": "file:../../packages/ct-wisdom-core"
  },
  "openclaw": {
    "extensions": [
      "./lib/src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.3"
    },
    "install": {
      "minHostVersion": ">=2026.10.3"
    }
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "tsc && node scripts/vendor_core.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "better-sqlite3": "^13.0.3",
    "node-gyp": "^12.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
